# Server Environment Variables (save as server/.env)
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendance?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Email Configuration (for OTP verification)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Office Geofencing Coordinates
OFFICE_LAT=40.7128
OFFICE_LNG=-74.0060
OFFICE_RADIUS_METERS=100

# Client Environment Variables (save as client/.env)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_OFFICE_LAT=40.7128
REACT_APP_OFFICE_LNG=-74.0060
REACT_APP_OFFICE_RADIUS_METERS=100
